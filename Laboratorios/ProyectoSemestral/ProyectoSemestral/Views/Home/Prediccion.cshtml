@model List<ProyectoSemestral.Models.PartidoViewModel>

@{
    ViewBag.Title = "Predicciones";
}
<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    body {
        background-image: url('/Content/img/predicciones.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        font-family: Arial, sans-serif;
    }

    table th, table td {
        border: none;
        padding: 10px;
    }

    table {
        background-color: white;
        border-radius: 12px;
        border-collapse: collapse;
        overflow: hidden;
        width: 100%;
        margin-bottom: 15px;
    }

    h2 {
        color: white;
        font-weight: 900;
        margin: 0;
    }

    .btn-secondary {
        background-color: #007bff;
        color: white;
    }

    .btn-titulo {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        cursor: pointer;
    }

    .titulo {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
        margin-bottom: 20px;

    }
</style>

<div class="titulo">
    <h2>🎯 Partidos disponibles para predecir</h2>
    <button class="btn-titulo" onclick="regresarMenu()">Volver al menú</button>
</div>

<table class="table table-bordered table-striped" id="prediccionesTable">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Equipo Local</th>
            <th>Goles Local</th>
            <th>Goles Visitante</th>
            <th>Equipo Visitante</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var partido in Model)
        {
            <tr data-id="@partido.ID_partido">
                <td>@partido.FechaPartido.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@partido.EquipoLocal</td>
                <td><input type="number" id="golLocal_@partido.ID_partido" min="0" style="width:50px;" /></td>
                <td><input type="number" id="golVisitante_@partido.ID_partido" min="0" style="width:50px;" /></td>
                <td>@partido.EquipoVisitante</td>
                <td>
                    <button class="btn btn-primary" onclick="enviarPrediccion(@partido.ID_partido)">Predecir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<button id="btnHistorial" class="btn btn-secondary">Ver historial de predicciones</button>

<div id="historialContainer" style="display:none; margin-top: 15px;">
    <table class="table table-bordered table-striped" id="historialTable">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Partido</th>
                <th>Predicción</th>
                <th>Resultado</th>
                <th>Puntos</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        const idUsuario = localStorage.getItem("idUsuario");

        function regresarMenu() {
            window.location.href = "/Home/Inicio";
        }

        function enviarPrediccion(idPartido) {
            if (!idUsuario) {
                alert("Debes iniciar sesión primero");
                return;
            }

            const golLocal = parseInt($('#golLocal_' + idPartido).val());
            const golVisitante = parseInt($('#golVisitante_' + idPartido).val());

            if (isNaN(golLocal) || isNaN(golVisitante)) {
                alert("Debes ingresar los goles predichos");
                return;
            }

            $.ajax({
                url: '/api/predicciones/crear',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ID_usuario: parseInt(idUsuario),
                    ID_partido: idPartido,
                    GolLocalPred: golLocal,
                    GolVisitantePred: golVisitante
                }),
                success: function (res) {
                    
                    $('tr[data-id="' + idPartido + '"]').fadeOut(400, function () { $(this).remove(); });
                },
                error: function (err) {
                    let msg = "Error al enviar predicción";
                    if (err.responseJSON && err.responseJSON.Message) msg = err.responseJSON.Message;
                    else if (err.responseJSON) msg = JSON.stringify(err.responseJSON);
                    alert(msg);
                }
            });
        }

        $('#btnHistorial').click(function () {
            if (!idUsuario) {
                alert("Debes iniciar sesión primero");
                return;
            }

            const container = $('#historialContainer');
            const tbody = $('#historialTable tbody');

            if (container.is(':visible')) {
                container.hide();
            } else {
                fetch(`/api/predicciones/historial/${idUsuario}`)
                    .then(res => res.json())
                    .then(data => {
                        tbody.empty();
                        if (!data || data.length === 0) {
                            tbody.append('<tr><td colspan="5">No hay predicciones registradas</td></tr>');
                        } else {
                            data.forEach(p => {
                                tbody.append(`
                                        <tr>
                                            <td>${new Date(p.FechaPartido).toLocaleString()}</td>
                                            <td>${p.EquipoLocal} vs ${p.EquipoVisitante}</td>
                                            <td>${p.GolLocalPred} - ${p.GolVisitantePred}</td>
                                            <td>${p.GolesLocal ?? "-"} - ${p.GolesVisitante ?? "-"}</td>
                                            <td>${p.PuntosObtenidos ?? 0}</td>
                                        </tr>
                                    `);
                            });
                        }
                        container.show();
                    })
                    .catch(() => {
                        tbody.html('<tr><td colspan="5">Error al cargar el historial</td></tr>');
                        container.show();
                    });
            }
        });
    </script>
}
