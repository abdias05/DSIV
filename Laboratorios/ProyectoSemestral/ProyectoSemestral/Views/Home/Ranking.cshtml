@{
    ViewBag.Title = "Ranking";
}

<style>
    body {
        background-image: url('/Content/img/3333.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        font-family: Arial, sans-serif;
    }

    .titulo {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 35px auto 20px auto ; /* Centrar horizontalmente */
        width: 100% !important; /* Fuerza el ancho deseado */
        max-width: 800px;
    }

    h2 {
        color: white;
        font-weight: 900;
        margin: 0;
    }

    .btn-titulo {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        cursor: pointer;
    }

    table.table {
        background-color: white;
        border-radius: 12px;
        border-collapse: collapse;
        overflow: hidden;
        width: 1000% !important; /* Fuerza el ancho deseado */
        max-width: 800px; /* No se haga más grande */
        margin: 0 auto 20px auto; /* Centrar horizontalmente */
        text-align: center;
        font-size: 14px; /* Tamaño de texto más compacto */
    }

        table.table th, table.table td {
            border: none !important; /* Eliminar bordes de Bootstrap */
            padding: 8px !important; /* Menor padding */
         
        }

    thead {
        font-weight: bold;
    }
</style>

<div class="titulo">
    <h2>🏆 Ranking de usuarios</h2>
    <button class="btn-titulo" onclick="regresarMenu()">Volver al menú</button>
</div>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Posición</th>
            <th>Usuario</th>
            <th>Puntos</th>
        </tr>
    </thead>
    <tbody id="rankingBody">
        <tr><td colspan="3">Cargando ranking...</td></tr>
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>

        function regresarMenu() {
            window.location.href = "/Home/Inicio";
        }

        $(document).ready(function () {
            $.getJSON('/api/ranking', function (data) {
                let html = '';
                data.forEach((u, index) => {
                    html += `<tr>
                                <td>${index + 1}</td>
                                <td>${u.Usuario}</td>
                                <td>${u.TotalPuntos}</td>
                             </tr>`;
                });
                if (data.length === 0) {
                    html = '<tr><td colspan="3">No hay usuarios con predicciones.</td></tr>';
                }
                $('#rankingBody').html(html);
            }).fail(() => {
                $('#rankingBody').html('<tr><td colspan="3">Error al cargar el ranking.</td></tr>');
            });
        });
    </script>
}
