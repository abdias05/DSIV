@model Parcial3.Models.Articulo

@{
    ViewBag.Title = "Crear Artículo";
}

<h2>Crear Artículo</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Titulo, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Titulo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Resumen, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.Resumen, new { @class = "form-control", rows = 3 })
            </div>
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.Año, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Año, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group mb-3">
            @Html.Label("Revista", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("RevistaId", (SelectList)ViewBag.Revistas, "--Seleccione--", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.InformeTecnico, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.InformeTecnico, new { @class = "form-control", rows = 4 })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="@Url.Action("ArticulosIndex", "Home")" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </div>
    </div>
}
