@model Parcial3.Models.Articulo

@{
    ViewBag.Title = "Editar Artículo";
}

<h2>Editar Artículo</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.HiddenFor(model => model.ArticuloId)

        <div class="form-group">
            @Html.LabelFor(model => model.Titulo)
            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Resumen)
            @Html.TextAreaFor(model => model.Resumen, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Año)
            @Html.TextBoxFor(model => model.Año, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.Label("Revista")
            @Html.DropDownListFor(model => model.RevistaId, (SelectList)ViewBag.Revistas, "Seleccione revista", new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a href="@Url.Action("ArticulosIndex")" class="btn btn-default">Cancelar</a>
    </div>
}
