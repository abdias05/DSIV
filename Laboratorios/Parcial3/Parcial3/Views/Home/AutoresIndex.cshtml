@model IEnumerable<Parcial3.Models.Autor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Autores";
}

<h2>Autores</h2>

<p><a href="@Url.Action("AutoresCreate", "Home")">Crear nuevo autor</a></p>

<table>
    <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Apellido</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AutorId</td>
            <td>@item.Nombre</td>
            <td>@item.Apellido</td>

            <td>
                <a href="@Url.Action("AutoresEdit", "Home", new { id = item.AutorId })">Editar</a> |

                @using (Html.BeginForm("AutoresDelete", "Home", new { id = item.AutorId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" onclick="return confirm('¿Está seguro de eliminar este autor?');">Eliminar</button>
                }
            </td>

        </tr>
    }
</table>
